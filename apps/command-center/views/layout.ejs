<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Emergixx Emergency Command Center</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
</head>
<body>
  <!-- Tactical Sidebar -->
  <aside class="app-sidebar">
    <div class="brand-header">
      <div class="brand-logo">EX</div>
      <div>
        <div class="brand-title">EMERGixx</div>
        <div class="brand-subtitle">Command Center</div>
      </div>
    </div>

    <ul class="nav-links">
      <li class="nav-item <%= currentPath === '/' || currentPath === '/dashboard' ? 'active' : '' %>">
        <a href="/dashboard">
          <span>📊</span>
          <span>Dashboard</span>
        </a>
      </li>
      <li class="nav-item <%= currentPath === '/map' ? 'active' : '' %>">
        <a href="/map">
          <span>🗺️</span>
          <span>Tactical Map</span>
        </a>
      </li>
      <li class="nav-item <%= currentPath === '/incidents' ? 'active' : '' %>">
        <a href="/incidents">
          <span>🚨</span>
          <span>Incidents & Triage</span>
        </a>
      </li>
      <li class="nav-item <%= currentPath === '/responders' ? 'active' : '' %>">
        <a href="/responders">
          <span>🚑</span>
          <span>Field Responders</span>
        </a>
      </li>
      <li class="nav-item <%= currentPath === '/audit' ? 'active' : '' %>">
        <a href="/audit">
          <span>🔐</span>
          <span>Crypto Audit Log</span>
        </a>
      </li>
    </ul>

    <div class="sidebar-footer">
      <div><b>Protocol:</b> EMERGIXX/1</div>
      <div><b>Mesh Gateway:</b> Online (Node EX-HQ-01)</div>
    </div>
  </aside>

  <!-- Main View Area -->
  <div class="main-content">
    <header class="top-bar">
      <div class="top-bar-left">
        <h1 class="page-heading"><%= title %></h1>
        <div class="status-pill">
          <span class="pulsing-dot"></span>
          <span>MESH SYNC ACTIVE</span>
        </div>
      </div>

      <div class="top-bar-actions">
        <button class="btn btn-danger" onclick="alert('Broadcasting emergency alert across mesh nodes...')">
          <span>📢</span> Broadcast Emergency Alert
        </button>
      </div>
    </header>

    <div class="content-body">
      <%- body %>
    </div>
  </div>

  <!-- Dispatch Modal -->
  <div id="dispatch-modal" class="modal-backdrop">
    <div class="modal-content">
      <h3 style="margin-bottom: 8px;">Dispatch Responder Unit</h3>
      <p style="font-size: 13px; color: var(--text-secondary); margin-bottom: 16px;" id="modal-incident-title"></p>
      <input type="hidden" id="modal-incident-id" />

      <div class="form-group">
        <label for="modal-responder-select">Select Available Field Unit</label>
        <select id="modal-responder-select" class="form-control">
          <option value="RESP-01">Rescue Unit 01 (Paramedic Alpha) - 1.2km</option>
          <option value="RESP-02">Boat Team Charlie (Water Rescue) - 2.5km</option>
          <option value="RESP-03">Hazmat & Structural Assessment - 4.1km</option>
        </select>
      </div>

      <div class="form-group">
        <label for="modal-dispatch-notes">Tactical Instructions / Relay Notes</label>
        <textarea id="modal-dispatch-notes" class="form-control" rows="3" placeholder="e.g. Bring stretcher and oxygen tank. Approach via north access."></textarea>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button class="btn btn-outline" onclick="closeDispatchModal()">Cancel</button>
        <button class="btn btn-primary" onclick="submitDispatch()">Confirm & Dispatch Unit</button>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
