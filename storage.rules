rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Emergency incident photos and attachments
    match /incidents/{incidentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                      request.resource.size < 10 * 1024 * 1024 && // 10MB limit
                      request.resource.contentType.matches('image/.*');
    }

    // Offline map tile packages and region bundles
    match /offline_maps/{regionId}/{allPaths=**} {
      allow read: if true; // Publicly downloadable offline bundles
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
