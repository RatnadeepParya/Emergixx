# Emergixx Environment Configuration Template

# Node.js Server Environment
NODE_ENV=development
PORT=3000

# Emergency Command Center Session & Security
SESSION_SECRET=emergixx_secure_session_secret_change_in_production
JWT_SECRET=emergixx_jwt_secret_change_in_production

# Firebase Service Account Credentials (JSON string or path to serviceAccountKey.json)
FIREBASE_PROJECT_ID=emergixx-mesh-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@emergixx-mesh-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://emergixx-mesh-dev-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=emergixx-mesh-dev.appspot.com

# P2P Mesh Protocol Configuration
PROTOCOL_VERSION=EMERGIXX/1
MAX_HOP_COUNT=10
DEFAULT_MESSAGE_TTL_HOURS=24
CRITICAL_MESSAGE_TTL_HOURS=72

# Authority Verification Public Keys (Hex-encoded Ed25519)
AUTHORITY_CIVIL_DEFENSE_PUBKEY=e04b2b647f48037efc7a52f94d937000e311a3d07e6b01a1a5b8f673322f2cb8
AUTHORITY_RED_CROSS_PUBKEY=f15c3c758a59148f0d8b630a5e048111f422b4e18f7c12b2b6c9078443303dc9
